[Unit]
Description=MINA server
After=network-online.target
Wants=network-online.target

[Service]
User=mina
Group=mina
EnvironmentFile=/etc/mina/secret.env
Environment=MINA_DB=/var/lib/mina/mina.db
Environment=MINA_HOST=0.0.0.0
Environment=MINA_PORT=80
# an acknowledged report is on disk: survives a power cut as well as a crash
Environment=MINA_SYNC=full
ExecStart=/opt/mina/bin/mina-server
StandardOutput=append:/var/log/mina/server.log
StandardError=inherit
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=1048576
LimitMEMLOCK=infinity
Restart=always
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/mina

[Install]
WantedBy=multi-user.target
